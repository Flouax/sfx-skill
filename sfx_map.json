    "error": {
      "label": "错误提示",
      "aliases": ["错误提示", "错误", "失败", "fail"],
      "queries": ["error beep", "negative notification"],
      "filter": {"duration": [0.15, 1.5]},
      "descriptor_filter": {},
      "target": {},
      "align": "start",
      "peak_target_db": -12,
      "local_tags": ["error", "fail", "wrong", "negative", "denied", "buzz"]
    }
  }
}
